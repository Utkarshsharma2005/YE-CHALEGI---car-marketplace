# ─── YE CHALEGI — Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# Port the Express server runs on
PORT=5000

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/used_cars_marketplace
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/used_cars_marketplace
MONGO_URI=mongodb://127.0.0.1:27017/used_cars_marketplace

# JWT signing secret — change this to a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_secure_random_secret_before_deploying

# Allowed CORS origins (comma-separated, no spaces)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Seed account credentials (used only by `node seed.js`).
# Leave unset to use the documented defaults.
SEED_ADMIN_EMAIL=admin@yechalegi.com
SEED_ADMIN_PASSWORD=admin123
SEED_SELLER_EMAIL=seller@test.com
SEED_SELLER_PASSWORD=seller123
